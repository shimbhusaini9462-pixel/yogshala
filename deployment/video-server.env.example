# Merge these into the .env of an official stable docker-jitsi-meet release.
# Replace the hostname, public VPS IP, email and application secret before deployment.
PUBLIC_URL=https://video.your-domain.com
JVB_ADVERTISE_IPS=YOUR_PUBLIC_VPS_IP
HTTP_PORT=80
HTTPS_PORT=443
ENABLE_HTTP_REDIRECT=1
ENABLE_LETSENCRYPT=1
LETSENCRYPT_DOMAIN=video.your-domain.com
LETSENCRYPT_EMAIL=yogshala.jaipur@gmail.com
ENABLE_AUTH=1
AUTH_TYPE=jwt
ENABLE_GUESTS=0
JWT_APP_ID=yogshala
JWT_APP_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ACCEPTED_ISSUERS=yogshala
JWT_ACCEPTED_AUDIENCES=yogshala
JWT_ALLOW_EMPTY=0
ENABLE_WELCOME_PAGE=0
ENABLE_CLOSE_PAGE=0
